// Bits for subtarget features that participate in instruction matching.
enum SubtargetFeatureBits : uint8_t {
  Feature_Not64BitModeBit = 5,
  Feature_In64BitModeBit = 2,
  Feature_IsX32ModeBit = 3,
  Feature_NotX32ModeBit = 6,
  Feature_In16BitModeBit = 0,
  Feature_Not16BitModeBit = 4,
  Feature_In32BitModeBit = 1,
};

inline FeatureBitset computeAvailableFeatures(const FeatureBitset &FB) {
  FeatureBitset Features;
  if (!FB[X86::Is64Bit])
    Features.set(Feature_Not64BitModeBit);
  if (FB[X86::Is64Bit])
    Features.set(Feature_In64BitModeBit);
  if (FB[X86::IsX32])
    Features.set(Feature_IsX32ModeBit);
  if (!FB[X86::IsX32])
    Features.set(Feature_NotX32ModeBit);
  if (FB[X86::Is16Bit])
    Features.set(Feature_In16BitModeBit);
  if (!FB[X86::Is16Bit])
    Features.set(Feature_Not16BitModeBit);
  if (FB[X86::Is32Bit])
    Features.set(Feature_In32BitModeBit);
  return Features;
}

