#undef GET_INSTRINFO_MEM_OPERAND_SIZE

namespace llvm_ks::X86 {

LLVM_READONLY
static int getMemOperandSize(int OpType) {
  switch (OpType) {
  default: return 0;
  case OpTypes::i8mem:
  case OpTypes::i8mem_NOREX:
    return 8;

  case OpTypes::f16mem:
  case OpTypes::i16mem:
    return 16;

  case OpTypes::f32mem:
  case OpTypes::i32mem:
  case OpTypes::i32mem_TC:
  case OpTypes::vx32mem:
  case OpTypes::vx32xmem:
  case OpTypes::vy32mem:
  case OpTypes::vy32xmem:
  case OpTypes::vz32mem:
    return 32;

  case OpTypes::f64mem:
  case OpTypes::i64mem:
  case OpTypes::i64mem_TC:
  case OpTypes::i64mem_w64TC:
  case OpTypes::vx64mem:
  case OpTypes::vx64xmem:
  case OpTypes::vy64mem:
  case OpTypes::vy64xmem:
  case OpTypes::vz64mem:
    return 64;

  case OpTypes::f80mem:
    return 80;

  case OpTypes::f128mem:
  case OpTypes::i128mem:
    return 128;

  case OpTypes::f256mem:
  case OpTypes::i256mem:
    return 256;

  case OpTypes::f512mem:
  case OpTypes::i512mem:
  case OpTypes::i512mem_GR16:
  case OpTypes::i512mem_GR32:
  case OpTypes::i512mem_GR64:
    return 512;

  }
}

