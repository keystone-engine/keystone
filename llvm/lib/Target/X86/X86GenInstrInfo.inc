#undef GET_INSTRINFO_MC_HELPERS

namespace llvm_ks::X86_MC {

bool isThreeOperandsLEA(const MCInst &MI) {
  switch(MI.getOpcode()) {
  case X86::LEA32r:
  case X86::LEA64r:
  case X86::LEA64_32r:
  case X86::LEA16r:
    return (
      MI.getOperand(1).isReg() 
      && MI.getOperand(1).getReg().isValid()
      && MI.getOperand(3).isReg() 
      && MI.getOperand(3).getReg().isValid()
      && (
        (
          MI.getOperand(4).isImm() 
          && MI.getOperand(4).getImm() != 0
        )
        || false
      )
    );
  default:
    return false;
    } // end of switch-stmt
}


} // namespace llvm_ks::X86_MC

