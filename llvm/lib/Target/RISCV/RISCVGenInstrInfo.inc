bool RISCVInstrInfo::isBaseQCStore(const MachineInstr &MI) {
    return llvm_ks::is_contained({RISCV::QC_E_SB, RISCV::QC_E_SH, RISCV::QC_E_SW}, MI.getOpcode());
}

bool RISCVInstrInfo::isBaseStore(const MachineInstr &MI) {
