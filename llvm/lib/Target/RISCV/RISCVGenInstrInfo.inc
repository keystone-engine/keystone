  case RISCV::PseudoVNCLIP_WI_MF2:
  case RISCV::PseudoVNCLIP_WI_MF2_MASK:
  case RISCV::PseudoVNCLIP_WI_MF4:
  case RISCV::PseudoVNCLIP_WI_MF4_MASK:
