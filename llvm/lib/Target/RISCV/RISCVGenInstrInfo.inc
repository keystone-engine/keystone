bool RISCVInstrInfo::isBaseLoad(const MachineInstr &MI) {
    return llvm_ks::is_contained({RISCV::LD, RISCV::LW, RISCV::LWU, RISCV::LH, RISCV::LHU, RISCV::LB, RISCV::LBU}, MI.getOpcode());
}

bool RISCVInstrInfo::isBaseQCLoad(const MachineInstr &MI) {
    return llvm_ks::is_contained({RISCV::QC_E_LB, RISCV::QC_E_LBU, RISCV::QC_E_LH, RISCV::QC_E_LHU, RISCV::QC_E_LW}, MI.getOpcode());
