const PseudoInfo *getPseudoInfo(unsigned Pseudo) {
  if ((unsigned)Pseudo != std::clamp<unsigned>(Pseudo, PseudoNDS_VD4DOTSU_VV_M1, PseudoVZIP_VV_MF8_MASK))
    return nullptr;

  struct KeyType {
    unsigned Pseudo;
  };
  KeyType Key = {Pseudo};
  struct Comp {
    bool operator()(const PseudoInfo &LHS, const KeyType &RHS) const {
      if (LHS.Pseudo < RHS.Pseudo)
        return true;
      if (LHS.Pseudo > RHS.Pseudo)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(RISCVVPseudosTable);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.Pseudo != Idx->Pseudo)
    return nullptr;

  return &*Idx;
}
