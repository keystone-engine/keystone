const NDSVLNPseudo *getNDSVLNPseudo(uint8_t Masked, uint8_t Unsigned, uint8_t Log2SEW, uint8_t LMUL) {
  struct KeyType {
    uint8_t Masked;
    uint8_t Unsigned;
    uint8_t Log2SEW;
    uint8_t LMUL;
  };
  KeyType Key = {Masked, Unsigned, Log2SEW, LMUL};
  struct Comp {
    bool operator()(const NDSVLNPseudo &LHS, const KeyType &RHS) const {
      if (LHS.Masked < RHS.Masked)
        return true;
      if (LHS.Masked > RHS.Masked)
        return false;
      if (LHS.Unsigned < RHS.Unsigned)
        return true;
      if (LHS.Unsigned > RHS.Unsigned)
        return false;
      if (LHS.Log2SEW < RHS.Log2SEW)
        return true;
      if (LHS.Log2SEW > RHS.Log2SEW)
        return false;
      if (LHS.LMUL < RHS.LMUL)
        return true;
      if (LHS.LMUL > RHS.LMUL)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(RISCVNDSVLNTable);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.Masked != Idx->Masked ||
      Key.Unsigned != Idx->Unsigned ||
      Key.Log2SEW != Idx->Log2SEW ||
      Key.LMUL != Idx->LMUL)
    return nullptr;

  return &*Idx;
}
