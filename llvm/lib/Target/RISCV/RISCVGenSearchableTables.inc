const PseudoInfo *getBaseInfoImpl(unsigned BaseInstr, uint8_t VLMul, uint8_t SEW, uint8_t IsAltFmt) {
  if ((unsigned)BaseInstr != std::clamp<unsigned>(BaseInstr, NDS_VD4DOTSU_VV, VZIP_VV))
    return nullptr;

  struct KeyType {
    unsigned BaseInstr;
    uint8_t VLMul;
    uint8_t SEW;
    uint8_t IsAltFmt;
  };
  KeyType Key = {BaseInstr, VLMul, SEW, IsAltFmt};
  struct Comp {
    bool operator()(const PseudoInfo &LHS, const KeyType &RHS) const {
      if (LHS.BaseInstr < RHS.BaseInstr)
        return true;
      if (LHS.BaseInstr > RHS.BaseInstr)
        return false;
      if (LHS.VLMul < RHS.VLMul)
        return true;
      if (LHS.VLMul > RHS.VLMul)
        return false;
      if (LHS.SEW < RHS.SEW)
        return true;
      if (LHS.SEW > RHS.SEW)
        return false;
