uint32_t RISCVMCCodeEmitter::getOperandBitOffset(const MCInst &MI,
    unsigned OpNum,
    const MCSubtargetInfo &STI) const {
  switch (MI.getOpcode()) {
    case RISCV::C_EBREAK:
    case RISCV::C_MOP_11:
    case RISCV::C_MOP_13:
    case RISCV::C_MOP_15:
    case RISCV::C_MOP_3:
    case RISCV::C_MOP_7:
    case RISCV::C_MOP_9:
    case RISCV::C_NOP:
    case RISCV::C_SSPOPCHK:
    case RISCV::C_SSPUSH:
    case RISCV::C_UNIMP:
    case RISCV::DRET:
    case RISCV::EBREAK:
    case RISCV::ECALL:
    case RISCV::FENCE_I:
    case RISCV::FENCE_TSO:
    case RISCV::MIPS_EHB:
    case RISCV::MIPS_IHB:
    case RISCV::MIPS_PAUSE:
    case RISCV::MNRET:
    case RISCV::MRET:
    case RISCV::QC_C_DI:
    case RISCV::QC_C_EI:
    case RISCV::QC_C_MIENTER:
    case RISCV::QC_C_MIENTER_NEST:
    case RISCV::QC_C_MILEAVERET:
    case RISCV::QC_C_MNRET:
    case RISCV::QC_C_MRET:
    case RISCV::SCTRCLR:
    case RISCV::SFENCE_INVAL_IR:
    case RISCV::SFENCE_W_INVAL:
    case RISCV::SF_CEASE:
    case RISCV::SF_VTDISCARD:
    case RISCV::SRET:
    case RISCV::TH_DCACHE_CALL:
    case RISCV::TH_DCACHE_CIALL:
    case RISCV::TH_DCACHE_IALL:
    case RISCV::TH_ICACHE_IALL:
    case RISCV::TH_ICACHE_IALLS:
    case RISCV::TH_L2CACHE_CALL:
    case RISCV::TH_L2CACHE_CIALL:
    case RISCV::TH_L2CACHE_IALL:
    case RISCV::TH_SYNC:
    case RISCV::TH_SYNC_I:
    case RISCV::TH_SYNC_IS:
    case RISCV::TH_SYNC_S:
    case RISCV::UNIMP:
    case RISCV::WFI:
    case RISCV::WRS_NTO:
    case RISCV::WRS_STO: {
      break;
    }
    case RISCV::AIF_FSWG_PS:
    case RISCV::AIF_FSWL_PS: {
      switch (OpNum) {
      case 0:
        // op: fs3
        return 7;
      case 1:
        // op: rs1
        return 15;
      }
      break;
    }
    case RISCV::C_NOP_HINT: {
      switch (OpNum) {
      case 0:
        // op: imm
        return 2;
      }
      break;
