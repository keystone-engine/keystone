const MUBUFInfo *getMUBUFOpcodeHelper(unsigned Opcode) {
  if ((unsigned)Opcode != std::clamp<unsigned>(Opcode, BUFFER_ATOMIC_ADD_ADDR64, BUFFER_WBL2))
    return nullptr;

  auto Table = ArrayRef(MUBUFInfoTable);
  size_t Idx = Opcode - BUFFER_ATOMIC_ADD_ADDR64;
  return &Table[Idx];
}

