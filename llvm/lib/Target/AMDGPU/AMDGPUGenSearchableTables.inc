const WMMAOpcodeMappingInfo *getWMMAMappingInfoFrom2AddrOpcode(unsigned Opcode2Addr) {
  struct KeyType {
    unsigned Opcode2Addr;
  };
  KeyType Key = {Opcode2Addr};
  struct Comp {
    bool operator()(const WMMAOpcodeMappingInfo &LHS, const KeyType &RHS) const {
      if (LHS.Opcode2Addr < RHS.Opcode2Addr)
        return true;
      if (LHS.Opcode2Addr > RHS.Opcode2Addr)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(WMMAOpcode2AddrMappingTable);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.Opcode2Addr != Idx->Opcode2Addr)
    return nullptr;

  return &*Idx;
}
