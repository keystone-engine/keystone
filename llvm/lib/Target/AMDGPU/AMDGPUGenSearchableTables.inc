    uint8_t OpX;
    uint8_t OpY;
    uint8_t SubTgt;
    bool VOPD3;
  };
  KeyType Key = {OpX, OpY, SubTgt, VOPD3};
  struct Comp {
    bool operator()(const IndexType &LHS, const KeyType &RHS) const {
      if (LHS.OpX < RHS.OpX)
        return true;
      if (LHS.OpX > RHS.OpX)
        return false;
      if (LHS.OpY < RHS.OpY)
        return true;
      if (LHS.OpY > RHS.OpY)
        return false;
      if (LHS.SubTgt < RHS.SubTgt)
        return true;
      if (LHS.SubTgt > RHS.SubTgt)
        return false;
      if (LHS.VOPD3 < RHS.VOPD3)
        return true;
      if (LHS.VOPD3 > RHS.VOPD3)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(Index);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.OpX != Idx->OpX ||
      Key.OpY != Idx->OpY ||
      Key.SubTgt != Idx->SubTgt ||
      Key.VOPD3 != Idx->VOPD3)
    return nullptr;

  return &VOPDPairs[Idx->_index];
}
