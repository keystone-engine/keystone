const WMMAOpcodeMappingInfo *getWMMAMappingInfoFrom3AddrOpcode(unsigned Opcode3Addr) {
  struct KeyType {
    unsigned Opcode3Addr;
  };
  KeyType Key = {Opcode3Addr};
  struct Comp {
    bool operator()(const WMMAOpcodeMappingInfo &LHS, const KeyType &RHS) const {
      if (LHS.Opcode3Addr < RHS.Opcode3Addr)
        return true;
      if (LHS.Opcode3Addr > RHS.Opcode3Addr)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(WMMAOpcode3AddrMappingTable);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.Opcode3Addr != Idx->Opcode3Addr)
    return nullptr;

  return &*Idx;
}
