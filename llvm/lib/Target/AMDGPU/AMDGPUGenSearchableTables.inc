const True16D16Info *getT16D16Helper(unsigned T16Op) {
  struct KeyType {
    unsigned T16Op;
  };
  KeyType Key = {T16Op};
  struct Comp {
    bool operator()(const True16D16Info &LHS, const KeyType &RHS) const {
      if (LHS.T16Op < RHS.T16Op)
        return true;
      if (LHS.T16Op > RHS.T16Op)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(True16D16Table);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.T16Op != Idx->T16Op)
    return nullptr;

  return &*Idx;
}
