const MIMGDimInfo *getMIMGDimInfoByAsmSuffix(StringRef AsmSuffix) {
  struct IndexType {
    unsigned AsmSuffix;
    unsigned _index;
  };
  static const struct IndexType Index[] = {
    { 1 /* "1D" */, 0 },
    { 4 /* "1D_ARRAY" */, 1 },
    { 13 /* "2D" */, 2 },
    { 16 /* "2D_ARRAY" */, 3 },
    { 39 /* "2D_MSAA" */, 5 },
    { 25 /* "2D_MSAA_ARRAY" */, 4 },
    { 47 /* "3D" */, 6 },
    { 50 /* "CUBE" */, 7 },
  };

  struct KeyType {
    std::string AsmSuffix;
  };
  KeyType Key = {AsmSuffix.upper()};
  struct Comp {
    bool operator()(const IndexType &LHS, const KeyType &RHS) const {
      StringRef LHSAsmSuffixStr = MIMGDimInfoTableStrings[LHS.AsmSuffix];
      StringRef RHSAsmSuffixStr = RHS.AsmSuffix;
      int CmpAsmSuffix = LHSAsmSuffixStr.compare(RHSAsmSuffixStr);
      if (CmpAsmSuffix < 0) return true;
      if (CmpAsmSuffix > 0) return false;
      return false;
    }
  };
  auto Table = ArrayRef(Index);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.AsmSuffix != MIMGDimInfoTableStrings[Idx->AsmSuffix])
    return nullptr;

  return &MIMGDimInfoTable[Idx->_index];
}

const MIMGDimInfo *getMIMGDimInfoByEncoding(uint8_t Encoding) {
  struct IndexType {
    uint8_t Encoding;
    unsigned _index;
  };
  static const struct IndexType Index[] = {
    { 0x0, 0 },
    { 0x1, 2 },
    { 0x2, 6 },
    { 0x3, 7 },
    { 0x4, 1 },
    { 0x5, 3 },
    { 0x6, 5 },
    { 0x7, 4 },
  };

  if ((uint8_t)Encoding != std::clamp<uint8_t>(Encoding, 0x0, 0x7))
    return nullptr;

  auto Table = ArrayRef(Index);
  size_t Idx = Encoding - 0x0;
  return &MIMGDimInfoTable[Table[Idx]._index];
}
