  case ARM::MCR: return getMCRDeprecationInfo(Inst, STI, Info);
  case ARM::MRC: return getMRCDeprecationInfo(Inst, STI, Info);
  case ARM::STMDA: return getARMStoreDeprecationInfo(Inst, STI, Info);
  case ARM::STMDA_UPD: return getARMStoreDeprecationInfo(Inst, STI, Info);
  case ARM::STMDB: return getARMStoreDeprecationInfo(Inst, STI, Info);
  case ARM::STMDB_UPD: return getARMStoreDeprecationInfo(Inst, STI, Info);
