static inline void InitXtensaMCRegisterInfo(MCRegisterInfo *RI, unsigned RA, unsigned DwarfFlavour = 0, unsigned EHFlavour = 0, unsigned PC = 0) {
  RI->InitMCRegisterInfo(XtensaRegDesc, 125, RA, PC, XtensaMCRegisterClassStorage.Classes, 8, XtensaRegUnitRoots, 124, XtensaRegDiffLists, XtensaLaneMaskLists, XtensaRegStrings, XtensaRegClassStrings, XtensaSubRegIdxLists, 1,
XtensaRegEncodingTable, nullptr);

  switch (DwarfFlavour) {
  default:
    llvm_unreachable("Unknown DWARF flavour");
  case 0:
    RI->mapDwarfRegsToLLVMRegs(XtensaDwarfFlavour0Dwarf2L, XtensaDwarfFlavour0Dwarf2LSize, false);
    break;
  }
  switch (EHFlavour) {
  default:
    llvm_unreachable("Unknown DWARF flavour");
  case 0:
    RI->mapDwarfRegsToLLVMRegs(XtensaEHFlavour0Dwarf2L, XtensaEHFlavour0Dwarf2LSize, true);
    break;
  }
  switch (DwarfFlavour) {
  default:
    llvm_unreachable("Unknown DWARF flavour");
  case 0:
    RI->mapLLVMRegsToDwarfRegs(XtensaDwarfFlavour0L2Dwarf, XtensaDwarfFlavour0L2DwarfSize, false);
    break;
  }
  switch (EHFlavour) {
  default:
    llvm_unreachable("Unknown DWARF flavour");
  case 0:
    RI->mapLLVMRegsToDwarfRegs(XtensaEHFlavour0L2Dwarf, XtensaEHFlavour0L2DwarfSize, true);
    break;
  }
}


