        if (memcmp(Name.data()+4, ".q", 2) != 0)
          break;
        return AArch64::ZAQ12;	 // "za12.q"
      case '3':	 // 1 string to match.
        if (memcmp(Name.data()+4, ".q", 2) != 0)
          break;
        return AArch64::ZAQ13;	 // "za13.q"
      case '4':	 // 1 string to match.
        if (memcmp(Name.data()+4, ".q", 2) != 0)
          break;
        return AArch64::ZAQ14;	 // "za14.q"
      case '5':	 // 1 string to match.
        if (memcmp(Name.data()+4, ".q", 2) != 0)
          break;
        return AArch64::ZAQ15;	 // "za15.q"
      }
      break;
    }
    break;
  }
  return AArch64::NoRegister;
}

