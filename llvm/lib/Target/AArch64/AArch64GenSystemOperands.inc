const LFIVariantEntry *lookupLFIVariantByOpcode(unsigned Inst) {
  struct KeyType {
    unsigned Inst;
  };
  KeyType Key = {Inst};
  struct Comp {
    bool operator()(const LFIVariantEntry &LHS, const KeyType &RHS) const {
      if (LHS.Inst < RHS.Inst)
        return true;
      if (LHS.Inst > RHS.Inst)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(LFIVariantTable);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.Inst != Idx->Inst)
    return nullptr;

  return &*Idx;
}
