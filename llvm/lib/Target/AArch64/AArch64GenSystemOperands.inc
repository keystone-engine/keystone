#ifdef GET_TINDEX_IMPL
constexpr TIndex TIndexsList[] = {
  { 1 /* "nb" */, 0x1 }, // 0
 };

#ifdef __GNUC__
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Woverlength-strings"
#endif
static constexpr char TIndexsListStringsStorage[] =
  "\0"
  "nb\0"
  "NB\0"
  ;
#ifdef __GNUC__
#pragma GCC diagnostic pop
#endif

static constexpr llvm_ks::StringTable
TIndexsListStrings = TIndexsListStringsStorage;

StringRef getTIndexStr(StringTable::Offset Offset) {
  return TIndexsListStrings[Offset];
}

const TIndex *lookupTIndexByName(StringRef Name) {
  struct IndexType {
    unsigned Name;
    unsigned _index;
  };
  static const struct IndexType Index[] = {
    { 4 /* "NB" */, 0 },
  };

  struct KeyType {
    std::string Name;
  };
  KeyType Key = {Name.upper()};
  struct Comp {
    bool operator()(const IndexType &LHS, const KeyType &RHS) const {
      StringRef LHSNameStr = TIndexsListStrings[LHS.Name];
      StringRef RHSNameStr = RHS.Name;
      int CmpName = LHSNameStr.compare(RHSNameStr);
      if (CmpName < 0) return true;
      if (CmpName > 0) return false;
      return false;
    }
  };
  auto Table = ArrayRef(Index);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.Name != TIndexsListStrings[Idx->Name])
    return nullptr;

  return &TIndexsList[Idx->_index];
}

const TIndex *lookupTIndexByEncoding(uint8_t Encoding) {
  struct IndexType {
    uint8_t Encoding;
    unsigned _index;
  };
  static const struct IndexType Index[] = {
    { 0x1, 0 },
  };

  if ((uint8_t)Encoding != std::clamp<uint8_t>(Encoding, 0x1, 0x1))
    return nullptr;

  auto Table = ArrayRef(Index);
  size_t Idx = Encoding - 0x1;
  return &TIndexsList[Table[Idx]._index];
}
