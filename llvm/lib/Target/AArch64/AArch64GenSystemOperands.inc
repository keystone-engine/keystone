  struct Comp {
    bool operator()(const SIMDPostEntry &LHS, const KeyType &RHS) const {
      if (LHS.Inst < RHS.Inst)
        return true;
      if (LHS.Inst > RHS.Inst)
        return false;
      return false;
    }
  };
  auto Table = ArrayRef(SIMDPostTable);
  auto Idx = std::lower_bound(Table.begin(), Table.end(), Key, Comp());
  if (Idx == Table.end() ||
      Key.Inst != Idx->Inst)
    return nullptr;

  return &*Idx;
}
