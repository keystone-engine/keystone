struct AArch64GenMCSubtargetInfo : public MCSubtargetInfo {
  AArch64GenMCSubtargetInfo(const Triple &TT,
    StringRef CPU, StringRef TuneCPU, StringRef FS,
    StringTable PN,
    ArrayRef<SubtargetFeatureKV> PF,
    ArrayRef<SubtargetSubTypeKV> PD,
    const MCSchedModel *PSM,
    const MCWriteProcResEntry *WPR,
    const MCWriteLatencyEntry *WL,
    const MCReadAdvanceEntry *RA, const InstrStage *IS,
    const unsigned *OC, const unsigned *FP) :
      MCSubtargetInfo(TT, CPU, TuneCPU, FS, PN, PF, PD, PSM,
                      WPR, WL, RA, IS, OC, FP) { }

  unsigned resolveVariantSchedClass(unsigned SchedClass,
      const MCInst *MI, const MCInstrInfo *MCII,
      unsigned CPUID) const final {
    return AArch64_MC::resolveVariantSchedClassImpl(SchedClass, MI, MCII, *this, CPUID);
  }
  bool isCPUStringValid(StringRef CPU) const final {
    CPU = AArch64::resolveCPUAlias(CPU);
    return MCSubtargetInfo::isCPUStringValid(CPU);
  }
};

static inline MCSubtargetInfo *createAArch64MCSubtargetInfoImpl(const Triple &TT, StringRef CPU, StringRef TuneCPU, StringRef FS) {
  CPU = AArch64::resolveCPUAlias(CPU);
  TuneCPU = AArch64::resolveCPUAlias(TuneCPU);
  return new AArch64GenMCSubtargetInfo(TT, CPU, TuneCPU, FS, StringTable(AArch64SubTypeKVStorage.Strings), AArch64FeatureKVStorage.Features, AArch64SubTypeKVStorage.SubTypes, nullptr, 
                      nullptr, nullptr, nullptr, 
                      nullptr, nullptr, nullptr);
}


